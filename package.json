    "elm": "^0.19.1-6",
    "express": "^4.21.1",
    "marked": "^15.0.2",
    "node-fetch": "^3.3.2",
    "sass": "^1.81.0"
  },
  "devDependencies": {
    "elm-format": "^0.8.7",
    "nodemon": "^3.1.7",
    "standard": "^17.1.2"
